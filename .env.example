# TrustChain UMKM — Environment Variables Template
# Copy this file to .env.local and update with your local settings.

# JWT Secret for Session & Authentication
JWT_SECRET=your-jwt-secret-key-at-least-32-chars-long

# Database Connection (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=trustchain_umkm

# Optional: AES-256 Key for Encrypting Wallet Private Keys (Recommended for Production)
# WALLET_ENCRYPTION_KEY=your-32-byte-hex-or-string-key
